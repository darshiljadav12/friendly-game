# Copy to .env and fill in. .env is git-ignored, never commit real credentials.

PORT=5000

# Where the client runs (use your deployed client URL in production)
CLIENT_ORIGIN=*

# MongoDB Atlas connection string; the path segment is the database name.
# Leave empty to keep rooms in memory only (lost on restart).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/friendly-game?retryWrites=true&w=majority
